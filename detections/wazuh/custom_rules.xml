<group name="ctum_sigma,">

  
  <rule id="100001" level="10">
    <if_sid>80700</if_sid>
    <field name="audit.command" type="pcre2">(?i)(nc|ncat|netcat|socat)</field>
    <description>Netcat-family execution on Linux - possible reverse shell staging [T1059.004]</description>
    <mitre>
      <id>T1059.004</id>
    </mitre>
  </rule>

  
  <rule id="100002" level="7">
    <if_sid>60109</if_sid>
    <description>CTUM: Local user account created (4720) [T1136.001]</description>
    <mitre>
      <id>T1136.001</id>
    </mitre>
  </rule>

  
  <rule id="100003" level="12">
    <if_group>sysmon_event_10</if_group>
    <field name="win.eventdata.targetImage" type="pcre2">(?i)\\lsass\.exe$</field>
    <field name="win.eventdata.grantedAccess" type="pcre2">(?i)^(?:0x1010|0x1410|0x1438|0x143a|0x1fffff|0x1010$|0x1410)</field>
    <description>CTUM: Sensitive handle to LSASS - credential dumping pattern [T1003.001]</description>
    <mitre>
      <id>T1003.001</id>
    </mitre>
  </rule>

  
  <rule id="100004" level="10">
    <if_group>sysmon_event1</if_group>
    <field name="win.eventdata.image" type="pcre2">(?i)\\powershell\.exe$|\\pwsh\.exe$</field>
    <field name="win.eventdata.commandLine" type="pcre2">(?i)DownloadString|DownloadFile|Net\.WebClient|Invoke-WebRequest|Invoke-RestMethod|Start-BitsTransfer</field>
    <field name="win.eventdata.commandLine" type="pcre2">(?i)Invoke-Expression|IEX\(|IEX\ </field>
    <description>CTUM: PowerShell download cradle - fetch and execute pattern [T1059.001]</description>
    <mitre>
      <id>T1059.001</id>
    </mitre>
  </rule>

  
  <rule id="100005" level="10">
    <if_group>sysmon_event1</if_group>
    <field name="win.eventdata.image" type="pcre2">(?i)\\powershell\.exe$|\\pwsh\.exe$</field>
    <field name="win.eventdata.commandLine" type="pcre2">(?i)\s-enc(od(edcommand)?)?\b|\s-EncodedCommand\b</field>
    <description>CTUM: PowerShell with encoded command [T1059.001]</description>
    <mitre>
      <id>T1059.001</id>
    </mitre>
  </rule>

  
  <rule id="100006" level="7">
    <if_sid>60228</if_sid>
    <field name="win.system.eventID">^4698$</field>
    <description>CTUM: Scheduled task created (4698) [T1053.005]</description>
    <mitre>
      <id>T1053.005</id>
    </mitre>
  </rule>

  
  <rule id="100007" level="10">
    <if_group>windows_security</if_group>
    <field name="win.system.eventID">^1102$</field>
    <description>CTUM: Windows Security event log cleared (1102) [T1685.005]</description>
    <mitre>
      <id>T1685.005</id>
    </mitre>
  </rule>

  
  <rule id="100008" level="5">
    <if_group>syslog,sshd,</if_group>
    <match>Failed password</match>
    <description>CTUM: SSH failed authentication [T1110.001]</description>
    <mitre>
      <id>T1110.001</id>
    </mitre>
  </rule>

  
  <rule id="100009" level="10" frequency="6" timeframe="600">
    <if_matched_sid>100008</if_matched_sid>
    <same_source_ip />
    <description>CTUM: SSH brute force - 6+ failed auths from one source in 10m [T1110.001]</description>
    <mitre>
      <id>T1110.001</id>
    </mitre>
  </rule>

  
  <rule id="100010" level="7">
    <if_sid>80700</if_sid>
    <field name="audit.command" type="pcre2">(?i)chmod</field>
    <field name="audit.args" type="pcre2">(?i)u\+s|4755|4750|4777</field>
    <description>CTUM: chmod setting SUID bit [T1548.001]</description>
    <mitre>
      <id>T1548.001</id>
    </mitre>
  </rule>

  
  <rule id="100011" level="10">
    <if_group>windows_system</if_group>
    <field name="win.system.eventID">^7045$</field>
    <field name="win.eventdata.imagePath" type="pcre2">(?i)\\Temp\\|\\Users\\Public\\|\\ProgramData\\|\\AppData\\|powershell|pwsh|\.ps1|\.vbs|\.hta</field>
    <description>CTUM: Service created with suspicious binary path [T1543.003]</description>
    <mitre>
      <id>T1543.003</id>
    </mitre>
  </rule>

</group>